# Copy to terraform.tfvars (ignored by Git). All values are examples, not real infrastructure.
proxmox_endpoint = "https://pve.example.invalid:8006/"
# Prefer TF_VAR_proxmox_api_token environment variable instead of writing the secret here.
node_name = "pve-node"
vm_id = 2400
