# Copy to /opt/vaultwarden/.env (never commit real values).
DOMAIN=https://vault.example.com
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
# Optional admin: leave unset to disable /admin entirely.
# For an admin panel, generate an Argon2 PHC token: docker run --rm -it ghcr.io/dani-garcia/vaultwarden:1.35.4 /vaultwarden hash
# ADMIN_TOKEN='$argon2id$...'
